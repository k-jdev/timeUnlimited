# PostgreSQL — products, categories, requests, users
CONNECTION_STRING=postgresql://user:password@host:5432/database

# Secret used to sign auth tokens. Use a long random string.
JWT_SECRET=

# Supabase project — product image storage only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Google AI Studio — watch photo analysis and description generation
GEMINI_API_KEY=
